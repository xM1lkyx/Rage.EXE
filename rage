    </button>

</div>


<!-- 1 -->

<div id="game1" class="screen">

    <h1>🌸 1. CATCH IT</h1>

    <p>Catch the button!</p>

    <div class="arena" id="arena1">

        <button id="runner">
            CLICK ME 💗
        </button>

    </div>

</div>


<!-- 2 -->

<div id="game2" class="screen">

    <h1>🎀 2. WHICH ONE?</h1>

    <p>Only ONE is real...</p>

    <div class="grid" id="realGrid"></div>

</div>


<!-- 3 -->

<div id="game3" class="screen">

    <h1>⏰ 3. DON'T CLICK YET</h1>

    <p id="waitText">WAIT...</p>

    <button id="waitButton" disabled>
        WAIT 💕
    </button>

</div>


<!-- 4 -->

<div id="game4" class="screen">

    <h1>🧠 4. MEMORY</h1>

    <p id="memoryText">
        WATCH THE SEQUENCE
    </p>

    <div
        class="memoryButtons"
        id="memoryButtons">
    </div>

</div>


<!-- 5 -->

<div id="game5" class="screen">

    <h1>🔢 5. ORDER</h1>

    <p>Click the numbers in order.</p>

    <div
        class="grid"
        id="numberGrid">
    </div>

</div>


<!-- 6 -->

<div id="game6" class="screen">

    <h1>⌨️ 6. TYPE IT</h1>

    <p>Type exactly:</p>

    <strong id="typeWord">
        RAGE IS TEMPORARY
    </strong>

    <br><br>

    <input
        id="typingInput"
        autocomplete="off"
        placeholder="type it here..."
    >

    <br>

    <button onclick="checkTyping()">
        SUBMIT 💗
    </button>

</div>


<!-- 7 -->

<div id="game7" class="screen">

    <h1>🔎 7. FIND IT</h1>

    <p>Find the hidden button...</p>

    <div class="arena" id="invisibleArena">

        <button
            id="invisibleButton"
            class="hidden">

            HERE 💗

        </button>

    </div>

</div>


<!-- 8 -->

<div id="game8" class="screen">

    <h1>🏃 8. DON'T TOUCH IT</h1>

    <p>Try to catch it!</p>

    <div class="arena" id="avoidArena">

        <button
            id="avoidButton"
            class="moving">

            DON'T 💕

        </button>

    </div>

</div>


<!-- 9 -->

<div id="game9" class="screen">

    <h1>🎀 9. NEXT?</h1>

    <p>Find the REAL NEXT button.</p>

    <div id="fakeNextArea"></div>

</div>


<!-- 10 -->

<div id="game10" class="screen">

    <h1>🎲 10. ROULETTE</h1>

    <p>One is safe...</p>

    <div
        class="grid"
        id="roulette">
    </div>

</div>


<!-- 11 -->

<div id="game11" class="screen">

    <h1>🧩 11. PUZZLE</h1>

    <p>Click 1 through 12.</p>

    <div
        class="grid"
        id="puzzle">
    </div>

</div>


<!-- 12 -->

<div id="game12" class="screen">

    <h1>👀 12. SPOT IT</h1>

    <p>Find the different symbol.</p>

    <div
        class="grid"
        id="difference">
    </div>

</div>


<!-- 13 -->

<div id="game13" class="screen">

    <h1>🎲 13. RANDOM</h1>

    <p id="randomText">
        PRESS THE BUTTON
    </p>

    <button onclick="randomChallenge()">
        TRY YOUR LUCK 💗
    </button>

</div>


<!-- 14 -->

<div id="game14" class="screen">

    <h1>💗 14. THREE STRIKES</h1>

    <p>Get three correct clicks.</p>

    <p>
        SCORE:
        <span id="strikeScore">0</span>/3
    </p>

    <button onclick="strikeGame()">
        CLICK 💕
    </button>

</div>


<!-- 15 -->

<div id="game15" class="screen">

    <h1>👑 FINAL BOSS 👑</h1>

    <p>Catch the NEXT button!</p>

    <div class="arena">

        <button id="bossButton">
