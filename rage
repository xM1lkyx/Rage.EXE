```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RAGE.exe 💗</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    background: #ffe6f0;
    color: #b83b68;
    font-family: "Courier New", monospace;
    text-align: center;
    overflow: hidden;
}

.screen {
    display: none;
    min-height: 100vh;
    width: 100%;
    padding: 25px;
    justify-content: center;
    align-items: center;
    flex-direction: column;
}

.screen.active {
    display: flex;
}

h1 {
    font-size: clamp(30px, 6vw, 65px);
    color: #c94f7c;
    text-shadow: 0 4px 12px rgba(201,79,124,.25);
}

p {
    font-size: 18px;
    color: #9f4968;
}

strong {
    color: #c94f7c;
}

button {
    background: #ffc4d9;
    color: #963b60;
    border: 2px solid #e889aa;
    border-radius: 14px;
    padding: 13px 25px;
    margin: 8px;
    font-family: inherit;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 5px 12px rgba(185,72,111,.18);
    transition: transform .15s, background .15s;
}

button:hover {
    background: #ffabc9;
    transform: scale(1.06);
}

button:active {
    transform: scale(.94);
}

button:disabled {
    opacity: .5;
    cursor: not-allowed;
}

input {
    background: #fff4f8;
    color: #963b60;
    border: 2px solid #e889aa;
    border-radius: 14px;
    padding: 14px;
    width: min(500px,90%);
    font-family: inherit;
    font-size: 18px;
    text-align: center;
    outline: none;
}

input:focus {
    border-color: #d95c8b;
    box-shadow: 0 0 0 4px rgba(232,137,170,.25);
}

.stats {
    position: fixed;
    top: 15px;
    right: 20px;
    color: #b83b68;
    background: #fff4f8;
    padding: 8px 14px;
    border-radius: 20px;
    border: 1px solid #efb0c6;
    z-index: 1000;
}

.arena {
    position: relative;
    width: min(900px,95vw);
    height: 55vh;
    background: rgba(255,255,255,.35);
    border: 2px solid #f1aec6;
    border-radius: 20px;
    overflow: hidden;
}

.moving {
    position: absolute;
    margin: 0;
}

.grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 10px;
    width: min(600px,90vw);
}

.grid button {
    margin: 0;
}

.memoryButtons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
}

.hidden {
    opacity: 0;
}

.final {
    max-width: 700px;
    line-height: 1.8;
    background: rgba(255,255,255,.4);
    padding: 30px;
    border-radius: 25px;
    border: 1px solid #efb0c6;
}

#fakeNextArea {
    position: relative;
    width: 100%;
    height: 60vh;
}

#bossButton {
    position: absolute;
}

.error {
    font-size: clamp(45px,10vw,100px);
    font-weight: bold;
    color: #d84f7e;
    animation: shake .12s infinite;
}

@keyframes shake {
    0%   { transform: translate(0); }
    25%  { transform: translate(-6px,4px); }
    50%  { transform: translate(6px,-4px); }
    75%  { transform: translate(-4px,-3px); }
    100% { transform: translate(0); }
}
</style>
</head>

<body>

<div class="stats">
    💗 LIVES: <span id="lives">3</span>
</div>


<!-- START -->

<div id="start" class="screen active">

    <h1>💗 RAGE.exe 💗</h1>

    <p>
        15 cute little challenges.
        <br>
        3 lives.
