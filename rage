</div>


<script>

let lives = 3;
let currentGame = 1;

const $ =
    id => document.getElementById(id);


/* =========================
   SCREEN CONTROL
========================= */

function show(id) {

    document
        .querySelectorAll(".screen")
        .forEach(
            s => s.classList.remove("active")
        );

    $(id).classList.add("active");
}


/* =========================
   LIVES
========================= */

function loseLife() {

    lives--;

    $("lives").textContent = lives;

    if (lives <= 0) {

        alert(
            "💗 YOU RAGED TOO HARD 💗\n\nSTART OVER!"
        );

        lives = 3;

        $("lives").textContent = 3;

        currentGame = 1;

        show("start");

        return true;
    }

    return false;
}


/* =========================
   START
========================= */

function startGame() {

    lives = 3;
    currentGame = 1;

    $("lives").textContent = 3;

    setupGame1();
}


/* =========================
   NEXT GAME
========================= */

function nextGame() {

    currentGame++;

    if (currentGame > 15) {

        show("win");

        return;
    }

    show("game" + currentGame);

    const setup =
        window[
            "setupGame" +
            currentGame
        ];

    if (setup) setup();
}


/* =========================
   GAME 1
   RANDOM MOVEMENT
========================= */

function setupGame1() {

    const button = $("runner");
    const arena = $("arena1");

    function move() {

        const x =
            Math.random() *
            Math.max(
                1,
                arena.clientWidth -
                button.offsetWidth
            );

        const y =
            Math.random() *
            Math.max(
                1,
                arena.clientHeight -
                button.offsetHeight
            );

        button.style.position = "absolute";
        button.style.left = x + "px";
        button.style.top = y + "px";
    }

    button.onclick = nextGame;
    button.onmouseenter = move;

    move();
}


/* =========================
   GAME 2
   RANDOM CORRECT BUTTON
========================= */

function setupGame2() {

    const grid = $("realGrid");

    grid.innerHTML = "";

    const correct =
        Math.floor(Math.random() * 12);

    for (let i = 0; i < 12; i++) {

        const b =
            document.createElement("button");

        b.textContent = "NEXT 💗";

        b.onclick = () => {

            if (i === correct) {

                nextGame();

            } else {

                if (!loseLife()) {

                    alert("🎀 WRONG BUTTON 🎀");
                }
            }
        };

        grid.appendChild(b);
    }
}


/* =========================
   GAME 3
   RANDOM DELAY
========================= */

function setupGame3() {

    const button = $("waitButton");
    const text = $("waitText");

    button.disabled = true;
    button.onclick = null;

    const seconds =
        Math.floor(Math.random() * 5) + 3;

    let remaining = seconds;

    text.textContent =
        "WAIT " + remaining;

    const timer =
        setInterval(() => {

            remaining--;

            if (remaining <= 0) {

                clearInterval(timer);

                text.textContent =
                    "NOW! 💗";

                button.disabled = false;
                button.textContent =
                    "CLICK NOW 💗";

                button.onclick = nextGame;

            } else {

                text.textContent =
                    "WAIT " + remaining;
            }

        }, 1000);
}


/* =========================
   GAME 4
   RANDOM MEMORY
========================= */

let memorySequence = [];
let memoryIndex = 0;

function setupGame4() {

    const container =
        $("memoryButtons");

    container.innerHTML = "";

    memorySequence = [];

    memoryIndex = 0;

    const length =
        Math.floor(Math.random() * 3) + 4;

    for (let i = 0; i < 4; i++) {

        const b =
            document.createElement("button");

        b.textContent =
            "💗 " + (i + 1);

        container.appendChild(b);
    }

    for (let i = 0; i < length; i++) {

        memorySequence.push(
            Math.floor(Math.random() * 4)
        );
    }

    let displayIndex = 0;

    const interval =
        setInterval(() => {

            if (
                displayIndex >=
                memorySequence.length
            ) {

                clearInterval(interval);

                $("memoryText")
                    .textContent =
                    "YOUR TURN 💕";

                return;
            }

            $("memoryText")
                .textContent =
                "CLICK " +
                (memorySequence[displayIndex] + 1);

            displayIndex++;

        }, 700);

    container
        .querySelectorAll("button")
        .forEach((button,index) => {

            button.onclick = () => {

                if (
                    index ===
                    memorySequence[memoryIndex]
                ) {

                    memoryIndex++;

                    if (
                        memoryIndex ===
                        memorySequence.length
                    ) {

                        nextGame();
                    }

                } else {

                    if (!loseLife()) {

                        alert(
                            "🧠 MEMORY FAILED 💗"
                        );
                    }
                }
            };
        });
}


/* =========================
   GAME 5
   RANDOM ORDER
========================= */

let numberNext = 1;

function setupGame5() {

    numberNext = 1;

    const grid =
        $("numberGrid");

    grid.innerHTML = "";

    let numbers =
        Array.from(
            {length:9},
            (_,i) => i + 1
        );

    numbers.sort(
        () => Math.random() - .5
    );

    numbers.forEach(num => {

        const b =
            document.createElement("button");

        b.textContent = num;

        b.onclick = () => {

            if (num === numberNext) {

                numberNext++;

                b.style.visibility =
                    "hidden";

                if (numberNext === 10) {

                    nextGame();
                }

            } else {

                if (!loseLife()) {

                    alert(
                        "🔢 WRONG ORDER 💗"
                    );
                }
            }
        };

        grid.appendChild(b);
    });
}


/* =========================
   GAME 6
   RANDOM WORD
========================= */

const typingWords = [

    "RAGE IS TEMPORARY",
    "PINK RAGE",
    "I WILL NOT RAGE",
    "CLICK THE BUTTON",
    "I LOVE CHALLENGES",
    "TRY AGAIN"

];

function setupGame6() {

    const word =
        typingWords[
            Math.floor(
                Math.random() *
                typingWords.length
            )
        ];

    $("typeWord").textContent =
        word;

    $("typingInput").value = "";
    $("typingInput").placeholder =
        "type it here...";
}

function checkTyping() {

    const expected =
        $("typeWord").textContent;

    if (
        $("typingInput").value ===
        expected
    ) {

        nextGame();

    } else {

        if (!loseLife()) {

            $("typingInput").value = "";

            $("typingInput")
                .placeholder =
                "NOPE... TRY AGAIN 💗";
        }
    }
}


/* =========================
   GAME 7
   RANDOM HIDDEN POSITION
========================= */

function setupGame7() {

    const arena =
        $("invisibleArena");

    const button =
        $("invisibleButton");

    button.classList.add("hidden");

    const x =
        Math.random() *
        Math.max(
            1,
            arena.clientWidth - 100
        );

    const y =
        Math.random() *
        Math.max(
            1,
            arena.clientHeight - 50
        );

    button.style.position = "absolute";
    button.style.left = x + "px";
    button.style.top = y + "px";

    const delay =
        Math.floor(Math.random() * 3000) + 1000;

    setTimeout(() => {

        button.classList.remove("hidden");

    }, delay);

    button.onclick = nextGame;
}


/* =========================
   GAME 8
   RANDOM MOVING BUTTON
========================= */

function setupGame8() {

    const arena =
        $("avoidArena");

    const button =
        $("avoidButton");

    function move() {

        button.style.left =
            Math.random() *
            Math.max(
                1,
                arena.clientWidth - 100
            ) + "px";

        button.style.top =
            Math.random() *
            Math.max(
                1,
                arena.clientHeight - 50
            ) + "px";
    }

    button.onmouseenter = move;

    button.onclick = () => {

        if (!loseLife()) {

            move();
        }
    };

    move();

    setTimeout(
        nextGame,
        Math.floor(Math.random() * 5000) + 8000
    );
}


/* =========================
   GAME 9
   RANDOM POSITION + ANSWER
========================= */

function setupGame9() {

    const area =
        $("fakeNextArea");

    area.innerHTML = "";

    const correct =
        Math.floor(Math.random() * 10);

    const positions = [];

    while (positions.length < 10) {

        const position = [

            Math.random() * 85,
            Math.random() * 75

        ];

        positions.push(position);
    }

    for (let i = 0; i < 10; i++) {

        const b =
            document.createElement("button");

        b.textContent =
            "NEXT 🎀";

        b.style.position =
            "absolute";

        b.style.left =
            positions[i][0] + "%";

        b.style.top =
            positions[i][1] + "%";

        b.onclick = () => {

            if (i === correct) {

                nextGame();

            } else {

                if (!loseLife()) {

                    alert(
                        "🎀 FAKE NEXT 🎀"
                    );
                }
            }
        };

        area.appendChild(b);
    }
}


/* =========================
   GAME 10
   RANDOM SAFE BUTTON
========================= */

function setupGame10() {

    const container =
        $("roulette");

    container.innerHTML = "";

    const safe =
        Math.floor(Math.random() * 12);

    for (let i = 0; i < 12; i++) {

        const b =
            document.createElement("button");

        b.textContent =
            ["💗","💕","🎀","🌸"][
                Math.floor(Math.random() * 4)
            ];

        b.onclick = () => {

            if (i === safe) {

                nextGame();

            } else {

                if (!loseLife()) {

                    alert("🎲 NOPE 💗");
                }
            }
        };

        container.appendChild(b);
    }
}


/* =========================
   GAME 11
   RANDOM PUZZLE
========================= */

let puzzleNext = 1;

function setupGame11() {

    puzzleNext = 1;

    const grid =
        $("puzzle");

    grid.innerHTML = "";

    let nums =
        Array.from(
            {length:12},
            (_,i) => i + 1
        );

    nums.sort(
        () => Math.random() - .5
    );

    nums.forEach(num => {

        const b =
            document.createElement("button");

        b.textContent = num;

        b.onclick = () => {

            if (num === puzzleNext) {

                puzzleNext++;

                b.style.visibility =
                    "hidden";

                if (puzzleNext === 13) {

                    nextGame();
                }

            } else {

                if (!loseLife()) {

                    alert(
                        "🧩 WRONG 💗"
                    );
                }
            }
        };

        grid.appendChild(b);
    });
}


/* =========================
   GAME 12
   RANDOM DIFFERENT SYMBOL
========================= */

function setupGame12() {

    const grid =
        $("difference");

    grid.innerHTML = "";

    const correct =
        Math.floor(Math.random() * 16);

    const symbols = [
        ["O","0"],
        ["X","×"],
        ["S","5"],
        ["B","8"]
    ];

    const pair =
        symbols[
            Math.floor(
                Math.random() *
                symbols.length
            )
        ];

    for (let i = 0; i < 16; i++) {

        const b =
            document.createElement("button");

        b.textContent =
            i === correct
                ? pair[0]
                : pair[1];

        b.onclick = () => {

            if (i === correct) {

                nextGame();

            } else {

                if (!loseLife()) {

                    alert(
                        "👀 NOT THAT ONE 💗"
                    );
                }
            }
        };

        grid.appendChild(b);
    }
}


/* =========================
   GAME 13
   RANDOM OUTCOME
========================= */

function randomChallenge() {

    const messages = [

        "TOO EASY 💗",
        "TRY AGAIN 🎀",
        "YOU REALLY CLICKED THAT?",
        "NOPE 🌸",
        "ALMOST 💕",
        "HAHA 💗",
        "KEEP GOING 🎀",
        "WRONG BUTTON 💗",
        "SO CLOSE 🌸",
        "MAYBE NEXT TIME 💕"

    ];

    const message =
        messages[
            Math.floor(
                Math.random() *
                messages.length
            )
        ];

    $("randomText")
        .textContent =
        message;

    if (Math.random() > .7) {

        nextGame();
    }
}


/* =========================
   GAME 14
   RANDOM STRIKES
========================= */

let strikes = 0;

function setupGame14() {

    strikes = 0;

    $("strikeScore")
        .textContent = "0";
}

function strikeGame() {

    if (Math.random() > .45) {

        strikes++;

        $("strikeScore")
            .textContent =
            strikes;

        if (strikes >= 3) {

            nextGame();
        }

    } else {

        strikes = 0;

        $("strikeScore")
            .textContent =
            "0";

        if (!loseLife()) {

            alert(
                "💗 THREE STRIKES 💗"
            );
        }
    }
}


/* =========================
   GAME 15
   RANDOM MOVEMENT
========================= */

function setupGame15() {

    const button =
        $("bossButton");

    const arena =
        button.parentElement;

    function move() {

        button.style.left =
            Math.random() *
            Math.max(
                1,
                arena.clientWidth - 100
            ) + "px";

        button.style.top =
            Math.random() *
            Math.max(
                1,
                arena.clientHeight - 50
            ) + "px";
    }

    button.onmouseenter =
        move;

    button.onclick =
        () => show("win");

    move();
}

</script>

</body>
</html>
